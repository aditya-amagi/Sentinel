# ── ATOM Telemetry API Configuration ──────────────────────────────────────────
# Leave ATOM_BASE_URL empty to use mock/demo mode. Include the /v1/api prefix.
# API docs: https://am-staging.amagi.tv/v1/api/docs
ATOM_BASE_URL=
# Auth — set ONE of: API key (X-API-Key header), static bearer JWT, or email+password login
ATOM_API_KEY=
ATOM_BEARER_TOKEN=
# Automatic token renewal (refresh token / email+password login) is OFF unless this is true
ATOM_ALLOW_TOKEN_RENEWAL=false
# SSO refresh token (from the ATOM web app). Sentinel renews the access token itself and saves each
# rotated refresh token to ATOM_SESSION_FILE (default backend/.atom_session.json — keep it out of git).
ATOM_REFRESH_TOKEN=
ATOM_SESSION_FILE=
ATOM_EMAIL=
ATOM_PASSWORD=
# Protect ATOM: hard cap on requests per rolling minute, requests in flight, and sync interval (minutes)
ATOM_MAX_REQUESTS_PER_MIN=20
ATOM_MAX_CONCURRENCY=1
# Sync interval per lane of ATOM views (minutes): Asset views, Schedule views, everything else (Live, Service Alerts)
ATOM_SYNC_ASSET_MIN=15
ATOM_SYNC_SCHEDULE_MIN=30
ATOM_SYNC_OTHER_MIN=15
# Ingest by ATOM saved views (default): auto = Schedule/Asset/Live views of ATOM_VIEW_GROUPS + Service Alerts; or view ids "16,19"; or off
# ATOM_VIEW_GROUPS=AN1,AN2,AN3,Cloudport Now,America,Enterprise Customer,EMEA,APAC
ATOM_VIEWS=auto
# Optional filters / paging for GET /alerts
# Empty ATOM_ALERT_TYPES = built-in list: the 4 TOC types + real fault types (skips asset_download_waiting,
# asset_submitted, asset_queued). Comma-separated list to override; * = every type.
ATOM_ALERT_TYPES=
# Only alerts whose issue starts within the last N hours, plus upcoming ones. 0 = no window.
ATOM_LOOKBACK_HOURS=72
ATOM_ALERT_STATES=active,snoozed
# Sentinel is feed-centric; only CP (CloudPort) alerts carry feed_code. Empty = all products.
ATOM_PRODUCT=CP
ATOM_PAGE_SIZE=500
ATOM_MAX_PAGES=20
# Re-fetch customer/feed catalog (names, timezones, headends) after this many hours
ATOM_CATALOG_REFRESH_HOURS=24
# Per-sync budgets for follow-up calls to ATOM
ATOM_RESOLVE_CHECKS_PER_SYNC=25
ATOM_PLAYLIST_LOOKUPS_PER_SYNC=20

# Write-back to ATOM (PATCH /alerts). OFF by default. When true:
#   Ack with a snooze choice → snoozes the ATOM alert; back to Penalty → de-snoozes
#   Freshdesk ticket created → comment with the ticket number/link on the ATOM alert
# Sentinel never resolves ATOM alerts.
ATOM_WRITEBACK=false

# Backend server port (default: 3001)
PORT=3001

# ── Freshdesk Configuration ───────────────────────────────────────────────────
# Leave empty to operate in mock ticket mode (generates INC-10001, etc.)
FRESHDESK_DOMAIN=yourcompany.freshdesk.com
FRESHDESK_API_KEY=your-freshdesk-api-key
FRESHDESK_GROUP_ID=your-group-id
FRESHDESK_TYPE=Issue

# Internal ticket recipient email (overrides all feed contacts for internal tickets)
INTERNAL_TICKET_EMAIL=amagisupportcontact@amagi.com

# ── Demo Mode ─────────────────────────────────────────────────────────────────
# Set to true to seed deterministic test broadcast data across APAC/US/EMEA feeds
DEMO_MODE=false

# ── OneLogin OIDC Authentication ──────────────────────────────────────────────
# Leave OIDC_ISSUER empty to run in DEV BYPASS mode (authenticates as dev@amagi.com)
OIDC_ISSUER=
OIDC_AUTH_URL=
OIDC_TOKEN_URL=
OIDC_USERINFO_URL=

OIDC_CLIENT_ID=your-client-id-from-onelogin
OIDC_CLIENT_SECRET=your-client-secret-from-onelogin

# Redirect URI registered in OneLogin application settings
# Development: http://localhost:3001/auth/callback
# Production:  https://yourdomain.com/auth/callback
OIDC_CALLBACK_URL=http://localhost:3001/auth/callback

# Session secret — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=dev-secret-change-in-production

# Only allow logins from this domain
ALLOWED_EMAIL_DOMAIN=@amagi.com

# Frontend URL (for post-login redirect & CORS)
FRONTEND_URL=http://localhost:3000
